# Chỉ dùng ở server; không đưa các giá trị thật vào Git.
DATABASE_URL=
# Chỉ đặt "disable" cho PostgreSQL local/test không hỗ trợ TLS.
DATABASE_SSL=

# AI là tùy chọn, chỉ dùng cho người dùng đã đăng nhập.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bắt buộc khi quản trị viên lưu Gemini trong Admin. Tạo chuỗi ngẫu nhiên dài 32+ ký tự; không đưa vào Git/chat.
APP_SECRET=

# Chỉ bật khi kiểm tra nội bộ. Không bật trên website chính thức.
ENABLE_PREVIEW_ADMIN=false
ADMIN_PREVIEW_PASSWORD=

# Chỉ bật tại bệnh viện có quy trình bác sĩ chỉ định chế độ ăn theo từng người bệnh.
ENABLE_DIET_ORDERS=false

# Địa chỉ website dùng để tạo QR thực đơn theo khoa.
PUBLIC_SITE_URL=http://localhost:3000

# Ảnh đối chứng suất ăn: bucket public-read nhưng không cấp quyền liệt kê công khai.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MEAL_PHOTO_BUCKET=meal-photos
