# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local agent config, dev logs, generated test outputs
.claude/
/outputs/
devserver*.log
devguide.log

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local/production databases and mutable runtime data
*.db
*.sqlite
*.sqlite3
/backups/
/uploads/
/public/storage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
