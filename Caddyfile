{$DOMAIN} {
  encode zstd gzip

  reverse_proxy app:3000

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
  }

  @nutrition_private path /api/nutrition/* /.well-known/oauth-* /ket-noi-ai/authorize*
  header @nutrition_private {
    >Referrer-Policy "no-referrer"
    >Cache-Control "no-store"
  }
  @nutrition_consent path /ket-noi-ai/authorize*
  header @nutrition_consent >X-Frame-Options "DENY"
}
