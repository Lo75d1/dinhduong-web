# Merge these settings into the existing protected .env.production.
# Do not replace DATABASE_URL or the rest of the current VPS configuration.
NUTRITION_PUBLIC_URL=https://dinhduong2598.food

# REQUIRED secret generated outside Git, at least 32 characters. Empty here by design.
APP_SECRET=

# Enable only when Next has no public port and all ingress is the trusted Caddy proxy.
NUTRITION_TRUST_PROXY=1

# Optional additional exact HTTPS callbacks. Built-in ChatGPT/Claude callbacks remain allowed.
# JSON array, no wildcard. Add only after checking the actual client callback.
NUTRITION_OAUTH_REDIRECT_URIS=[]

# Optional additional browser origins, comma separated. Same-site is already accepted.
NUTRITION_ALLOWED_ORIGINS=
